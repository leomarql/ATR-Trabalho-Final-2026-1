# '#' so inicia comentario no comeco da linha; um '#' depois do padrao vira
# parte do padrao e o quebra (foi o que deixou estes itens subirem ao repo).
# ---------------------------------------------------------------------------

# Pesos do modelo YOLO (baixados automaticamente; ~6 MB, nao versionar)
*.pt

